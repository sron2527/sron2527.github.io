{
  "name": "likhitthai-studio-desktop",
  "version": "1.0.1",
  "description": "Windows desktop launcher for LikhitThai Studio",
  "private": true,
  "author": "Sron2527",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sron2527.likhitthaistudio",
    "productName": "LikhitThai Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LikhitThai-Studio-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LikhitThai Studio",
      "perMachine": false
    }
  }
}
